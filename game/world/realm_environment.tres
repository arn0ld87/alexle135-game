; Weltumgebung für Alexle Realm.
;
; Trägt die Art Direction aus docs/RESEARCH.md Abschnitt 5:
; dunkel mit Blaustich, Blau ist Bedeutung statt Dekoration, kein Bloom-Gewitter.
;
; Der Glow ist bewusst schwach und hoch angesetzt (hdr_threshold 1.1): Nur was
; wirklich emittiert — blaue Akzente, Checkpoint-Säulen, Quest-Marker — leuchtet.
; Ein niedriger Schwellwert würde die ganze Szene weichzeichnen und die Regel
; "was blau leuchtet, ist benutzbar" unlesbar machen.

[gd_resource type="Environment" load_steps=3 format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial_realm"]
sky_top_color = Color(0.035, 0.045, 0.07, 1)
sky_horizon_color = Color(0.09, 0.13, 0.2, 1)
sky_curve = 0.15
sky_energy_multiplier = 0.6
ground_bottom_color = Color(0.02, 0.025, 0.04, 1)
ground_horizon_color = Color(0.07, 0.1, 0.16, 1)
ground_curve = 0.08
ground_energy_multiplier = 0.4
sun_angle_max = 25.0
sun_curve = 0.12

[sub_resource type="Sky" id="Sky_realm"]
sky_material = SubResource("SkyMaterial_realm")

[resource]
background_mode = 2
sky = SubResource("Sky_realm")
ambient_light_source = 3
ambient_light_color = Color(0.302, 0.639, 1, 1)
ambient_light_sky_contribution = 0.7
ambient_light_energy = 0.35
tonemap_mode = 3
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.4
ssao_power = 1.5
glow_enabled = true
glow_intensity = 0.5
glow_strength = 0.85
glow_bloom = 0.05
glow_blend_mode = 1
glow_hdr_threshold = 1.1
glow_hdr_scale = 2.0
fog_enabled = true
fog_light_color = Color(0.075, 0.102, 0.149, 1)
fog_light_energy = 0.8
fog_density = 0.012
fog_height = 8.0
fog_height_density = 0.02
adjustment_enabled = true
