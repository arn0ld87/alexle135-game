; Weltumgebung für Alexle Realm.
;
; Trägt die Art Direction aus docs/RESEARCH.md Abschnitt 5:
; warmes Dunkel als Grund, Blau ist Bedeutung statt Dekoration, kein Bloom-Gewitter.
;
; Die Basis folgt der Website-Palette (warm-monochrom). Blau bleibt die einzige
; kalte Farbe im Bild und markiert dadurch umso deutlicher, was benutzbar ist.
; Umgerechnet wurde bei gleichbleibender Luminanz, damit die Helligkeitsstaffelung
; zwischen Himmel, Boden, Wand und Nebel unverändert bleibt.
;
; Der Glow ist bewusst schwach und hoch angesetzt (hdr_threshold 1.1): Nur was
; wirklich emittiert — blaue Akzente, Checkpoint-Säulen, Quest-Marker — leuchtet.
; Ein niedriger Schwellwert würde die ganze Szene weichzeichnen und die Regel
; "was blau leuchtet, ist benutzbar" unlesbar machen.

[gd_resource type="Environment" load_steps=3 format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial_realm"]
sky_top_color = Color(0.053, 0.044, 0.033, 1)
sky_horizon_color = Color(0.149, 0.124, 0.094, 1)
sky_curve = 0.15
sky_energy_multiplier = 0.6
ground_bottom_color = Color(0.029, 0.024, 0.019, 1)
ground_horizon_color = Color(0.115, 0.095, 0.072, 1)
ground_curve = 0.08
ground_energy_multiplier = 0.4
sun_angle_max = 25.0
sun_curve = 0.12

[sub_resource type="Sky" id="Sky_realm"]
sky_material = SubResource("SkyMaterial_realm")

[resource]
background_mode = 2
sky = SubResource("Sky_realm")
ambient_light_source = 3
ambient_light_color = Color(0.664, 0.584, 0.478, 1)
ambient_light_sky_contribution = 0.7
ambient_light_energy = 0.35
tonemap_mode = 3
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.4
ssao_power = 1.5
glow_enabled = true
glow_intensity = 0.5
glow_strength = 0.85
glow_bloom = 0.05
glow_blend_mode = 1
glow_hdr_threshold = 1.1
glow_hdr_scale = 2.0
fog_enabled = true
fog_light_color = Color(0.117, 0.097, 0.074, 1)
fog_light_energy = 0.8
fog_density = 0.012
fog_height = 8.0
fog_height_density = 0.02
adjustment_enabled = true
adjustment_contrast = 1.06
adjustment_saturation = 0.94
